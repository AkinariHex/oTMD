{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "osu! Tourney Match Displayer",
  "mainBinaryName": "otmd",
  "version": "3.0.0-beta.1",
  "identifier": "com.akinari.osu-tourney-match-displayer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://raw.githubusercontent.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self'; frame-src http://127.0.0.1:21086",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "app", "dmg"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyMzc4OTE3MDBDODA1M0YKUldRL0JjZ0FGNGszOGpnUjg5eFZhQnRYcHM1em9XbG5EbzFGb1c1ZUlEakIxVUhEMFl0bk5CVUgK",
      "endpoints": [
        "https://raw.githubusercontent.com/AkinariHex/oTMD/master/updater/stable.json"
      ]
    }
  }
}
