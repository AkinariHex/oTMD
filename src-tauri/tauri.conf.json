{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "osu! Tourney Match Displayer",
  "mainBinaryName": "otmd",
  "version": "2.0.0",
  "identifier": "com.akinari.osu-tourney-match-displayer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "osu! Tourney Match Displayer",
        "width": 1000,
        "height": 600,
        "resizable": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://osu.ppy.sh https://otmd.app https://raw.githubusercontent.com; img-src 'self' data: https://a.ppy.sh https://raw.githubusercontent.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com",
      "devCsp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
